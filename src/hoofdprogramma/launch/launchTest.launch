
<launch>
  <arg name="sim" default="false"/>
  <arg name="robot_ip" default="192.168.1.158" />

  <node name="carousel_node" pkg="carousel_control" type="carousel_node.py" output="screen" />

  <!-- GUI Node -->
  <node pkg="hmi_ros" type="hmi_gui.py" name="hmi_gui" output="screen" />

  <!-- Status-simulator Node -->
  <node pkg="hmi_ros" type="status_simulator.py" name="status_simulator" output="screen" />

  <!-- Robot-aansturing Node -->
  <node pkg="hmi_ros" type="hmi_to_robot.py" name="hmi_to_robot" output="screen" />

  <!-- Start robot (real of sim) -->
  <group unless="$(arg sim)">

    <!-- Start echte robot -->
    <include file="$(find my_lite6_moveit_config)/launch/realMove_exec.launch">
      <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>
  </group>
    <!-- Start Simulatie robot-->
  <group if="$(arg sim)">
     <!--Start simulatie-->
    <include file="$(find my_lite6_moveit_config)/launch/demo.launch"/>
  </group>

</launch>
